---
layout: base.njk
permalink: /
---
<h1>{{ site.title }}</h1>
<p class="lede">One X post, one page. Share the link anywhere (WeChat works).</p>
{% if posts.length %}
<ul class="index">
  {% for post in posts %}
  <li>
    <a href="{{ post.page_url | url }}">
      <span class="index-title">{{ post.title }}</span>
      <span class="byline">
        {{ post.author_name or "Unknown author" }}
        {% if post.author_handle %} · @{{ post.author_handle }}{% endif %}
        {% if post.created_at %} · <time datetime="{{ post.created_at }}">{{ post.created_at_display or post.created_at }}</time>{% endif %}
      </span>
    </a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No posts yet.</p>
{% endif %}
