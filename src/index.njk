---
layout: base.njk
permalink: /
---
<h1>{{ site.title }}</h1>
<p class="lede">One X post, one page. Share the link anywhere.</p>
{% if posts.length %}
<ul class="index">
  {% for post in posts %}
  <li>
    <a href="{{ post.page_url | url }}">
      <span class="index-title">{{ post.title }}</span>
      <span class="byline">
        {{ post.author_name or "Unknown author" }}
        {% if post.author_handle %} · @{{ post.author_handle }}{% endif %}
        {% if post.created_at %}<span class="byline-time"> · <time datetime="{{ post.created_at }}">{{ post.created_at_display or post.created_at }}</time></span>{% endif %}
      </span>
      {% set excerpt = post.summary_en or post.summary_zh %}
      {% if excerpt %}
      <span class="index-excerpt">{{ excerpt }}</span>
      {% endif %}
    </a>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No posts yet.</p>
{% endif %}
