---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/x/{{ pagination.items[0].status_id }}/"
---
<article>
  <h1>{{ post.title }}</h1>

  <section class="meta" id="meta" aria-labelledby="meta-heading">
    <h2 id="meta-heading">Source</h2>
    <dl>
      <div>
        <dt>Author</dt>
        <dd class="author-name">{{ post.author_name or "Unknown" }}</dd>
      </div>
      <div>
        <dt>Handle</dt>
        <dd class="author-handle">{% if post.author_handle %}@{{ post.author_handle }}{% else %}Unknown{% endif %}</dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>
          {% if post.created_at %}
          <time datetime="{{ post.created_at }}">{{ post.created_at }}</time>
          {% if post.created_at_display %}<span class="readable">{{ post.created_at_display }}</span>{% endif %}
          {% else %}
          Unknown
          {% endif %}
        </dd>
      </div>
      <div>
        <dt>Original</dt>
        <dd><a class="original-url" href="{{ post.original_url }}">Open on X</a></dd>
      </div>
    </dl>
  </section>

  <section class="summary" id="summary" aria-labelledby="summary-heading">
    <h2 id="summary-heading">Summary</h2>
    <p class="label-note">AI-generated for skimming. Not a substitute for the original.</p>
    {% if post.summary_en or post.summary_zh %}
      {% if post.summary_en and post.summary_zh %}
      <input class="lang-input show-en" type="radio" name="summary-lang" id="summary-lang-en" checked>
      <input class="lang-input show-zh" type="radio" name="summary-lang" id="summary-lang-zh">
      <div class="lang-toggle">
        <label class="opt-en" for="summary-lang-en">English</label>
        <label class="opt-zh" for="summary-lang-zh">Chinese</label>
      </div>
      {% endif %}
      {% if post.summary_en %}
      <div class="summary-body is-en" lang="en">{{ post.summary_en | renderText | safe }}</div>
      {% endif %}
      {% if post.summary_zh %}
      <div class="summary-body is-zh" lang="zh-CN">{{ post.summary_zh | renderText | safe }}</div>
      {% endif %}
    {% else %}
    <p class="missing">No summary yet. Add a summary in the content file, then publish.</p>
    {% endif %}
  </section>

  <section class="original" id="original" lang="en" aria-labelledby="original-heading">
    <h2 id="original-heading">Original</h2>
    <div class="original-body">{{ post.full_text | renderText | safe }}</div>
    {% if post.images.length %}
    <div class="images">
      {% for image in post.images %}
      <img src="{{ image }}" alt="Post image" loading="lazy">
      {% endfor %}
    </div>
    {% endif %}
  </section>
</article>
