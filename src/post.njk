---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/x/{{ pagination.items[0].status_id }}/"
---
<article>
  <h1{% if (post.title | contentLang) == "zh-CN" %} lang="zh-CN"{% endif %}>{{ post.title }}</h1>

  <section class="meta" id="meta" aria-labelledby="meta-heading">
    <h2 id="meta-heading">Source</h2>
    <dl>
      <div>
        <dt>Author</dt>
        <dd class="author-name"{% if (post.author_name | contentLang) == "zh-CN" %} lang="zh-CN"{% endif %}>{{ post.author_name or "Unknown" }}</dd>
      </div>
      <div>
        <dt>Handle</dt>
        <dd class="author-handle">{% if post.author_handle %}@{{ post.author_handle }}{% else %}Unknown{% endif %}</dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>
          {% if post.created_at %}
          <time datetime="{{ post.created_at }}">{{ post.created_at_display or post.created_at }}</time>
          {% else %}
          Unknown
          {% endif %}
        </dd>
      </div>
      <div>
        <dt>Original</dt>
        <dd><a class="original-url" href="{{ post.original_url }}">Open on X</a></dd>
      </div>
    </dl>
  </section>

  <section class="summary" id="summary" aria-labelledby="summary-heading">
    <div class="summary-head">
      <h2 id="summary-heading">AI summary</h2>
      {% if post.summary_en or post.summary_zh %}
      <div class="seg lang-switch" role="group" aria-label="Summary language">
        <button type="button" data-lang="en" aria-pressed="{{ 'true' if post.summary_en else 'false' }}"{% if not post.summary_en %} disabled{% endif %}>English</button>
        <span class="seg-gap" aria-hidden="true">·</span>
        <button type="button" data-lang="zh" aria-pressed="{{ 'true' if (post.summary_zh and not post.summary_en) else 'false' }}"{% if not post.summary_zh %} disabled{% endif %}>Chinese</button>
      </div>
      {% endif %}
    </div>
    <p class="label-note">AI-generated for skimming. Not a substitute for the original.</p>
    {% if post.summary_en and not post.summary_zh %}
    <p class="missing">Chinese summary unavailable.</p>
    {% elif post.summary_zh and not post.summary_en %}
    <p class="missing">English summary unavailable.</p>
    {% elif not post.summary_en and not post.summary_zh %}
    <p class="missing">No summary yet. Add a summary in the content file, then publish.</p>
    {% endif %}
    {% if post.summary_en %}
    <div class="summary-body is-en" id="summary-en" lang="en">{{ post.summary_en | renderText | safe }}</div>
    {% endif %}
    {% if post.summary_zh %}
    <div class="summary-body is-zh" id="summary-zh" lang="zh-CN">{{ post.summary_zh | renderText | safe }}</div>
    {% endif %}
    {% if post.summary_en and post.summary_zh %}
    <noscript><a href="#summary-zh">Chinese</a></noscript>
    <script>
      (function () {
        var root = document.currentScript.closest(".summary");
        var buttons = root.querySelectorAll(".lang-switch button[data-lang]");
        buttons.forEach(function (button) {
          button.addEventListener("click", function () {
            if (button.disabled) return;
            var lang = button.getAttribute("data-lang");
            root.classList.toggle("is-zh-on", lang === "zh");
            buttons.forEach(function (item) {
              item.setAttribute("aria-pressed", item === button ? "true" : "false");
            });
          });
        });
      }());
    </script>
    {% endif %}
  </section>

  <section class="original" id="original" aria-labelledby="original-heading">
    <h2 id="original-heading">Original</h2>
    {% set originalLang = post.full_text | contentLang %}
    <div class="original-body"{% if originalLang %} lang="{{ originalLang }}"{% endif %}>{{ post.full_text | renderText | safe }}</div>
    {% if post.videos and post.videos.length %}
    <div class="videos">
      {% for video in post.videos %}
      <video controls playsinline preload="metadata"{% if video.poster %} poster="{{ video.poster | url }}"{% endif %} aria-label="Post video">
        <source src="{{ video.src | url }}"{% if video.type %} type="{{ video.type }}"{% endif %}>
      </video>
      {% endfor %}
    </div>
    {% endif %}
    {% if post.display_images and post.display_images.length %}
    <div class="images">
      {% for image in post.display_images %}
      <img src="{{ image | url }}" alt="Post image" loading="lazy">
      {% endfor %}
    </div>
    {% endif %}
  </section>
</article>
