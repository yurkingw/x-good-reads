---
layout: base.njk
pagination:
  data: posts
  size: 1
  alias: post
permalink: "/x/{{ pagination.items[0].status_id }}/"
---
<article>
  <h1>{{ post.title }}</h1>

  <section class="summary" id="summary" lang="en" aria-labelledby="summary-heading">
    <h2 id="summary-heading">AI summary</h2>
    <p class="label-note">Generated to help you skim. It does not replace the original.</p>
    {% if post.summary %}
    <div class="summary-body">{{ post.summary | renderText | safe }}</div>
    {% else %}
    <p class="missing">No summary yet. Add a summary field to the content file before publishing.</p>
    {% endif %}
  </section>

  <section class="meta" id="meta" aria-labelledby="meta-heading">
    <h2 id="meta-heading">Source</h2>
    <dl>
      <div>
        <dt>Author</dt>
        <dd class="author-name">{{ post.author_name or "Unknown" }}</dd>
      </div>
      <div>
        <dt>Handle</dt>
        <dd class="author-handle">{% if post.author_handle %}@{{ post.author_handle }}{% else %}Unknown{% endif %}</dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd>
          {% if post.created_at %}
          <time datetime="{{ post.created_at }}">{{ post.created_at }}</time>
          {% if post.created_at_display %}<span class="readable">{{ post.created_at_display }}</span>{% endif %}
          {% else %}
          Unknown
          {% endif %}
        </dd>
      </div>
      <div>
        <dt>Original post</dt>
        <dd><a class="original-url" href="{{ post.original_url }}">{{ post.original_url }}</a></dd>
      </div>
    </dl>
  </section>

  <section class="original" id="original" aria-labelledby="original-heading">
    <h2 id="original-heading">Original text</h2>
    <div class="original-body">{{ post.full_text | renderText | safe }}</div>
    {% if post.images.length %}
    <div class="images">
      {% for image in post.images %}
      <img src="{{ image }}" alt="Image from the original post" loading="lazy">
      {% endfor %}
    </div>
    {% endif %}
  </section>
</article>
