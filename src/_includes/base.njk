<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      try {
        var mode = localStorage.getItem("ygh-theme");
        if (mode !== "day" && mode !== "night" && mode !== "system") {
          mode = localStorage.getItem("xgr-theme");
          if (mode === "day" || mode === "night" || mode === "system") {
            localStorage.setItem("ygh-theme", mode);
          }
        }
        if (mode === "day" || mode === "night") {
          document.documentElement.setAttribute("data-theme", mode);
        }
      } catch (e) {}
    })();
  </script>
  <title>{% if post %}{{ post.title }} · {% endif %}{{ site.title }}</title>
  {% if post and post.summary_plain %}
  <meta name="description" content="{{ post.summary_plain }}">
  <meta property="og:description" content="{{ post.summary_plain }}">
  {% else %}
  <meta name="description" content="{{ site.description }}">
  <meta property="og:description" content="{{ site.description }}">
  {% endif %}
  {% if post %}
  <link rel="canonical" href="{{ site.baseUrl }}/x/{{ post.status_id }}/">
  <meta property="og:title" content="{{ post.title }}">
  <meta property="og:url" content="{{ site.baseUrl }}/x/{{ post.status_id }}/">
  <meta property="og:type" content="article">
  {% if post.created_at_display %}
  <meta property="article:published_time" content="{{ post.created_at }}">
  {% endif %}
  {% else %}
  <link rel="canonical" href="{{ site.baseUrl }}/">
  <meta property="og:title" content="{{ site.title }}">
  <meta property="og:url" content="{{ site.baseUrl }}/">
  <meta property="og:type" content="website">
  {% endif %}
  <meta property="og:locale" content="en_US">
  {% set share_title = post.title if post else site.title %}
  {% set share_description = post.summary_plain if (post and post.summary_plain) else site.description %}
  {% set share_image = post.og_image if (post and post.og_image) else site.ogImage %}
  <meta property="og:image" content="{{ share_image }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ share_title }}">
  <meta name="twitter:description" content="{{ share_description }}">
  <meta name="twitter:image" content="{{ share_image }}">
  <link rel="icon" href="{{ "/favicon.svg" | url }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ "/css/site.css" | url }}">
</head>
<body{% if post %} class="is-post"{% else %} class="is-home"{% endif %}>
  <header class="top">
    <div class="top-inner">
      <div class="brand-lockup">
        <a class="root-link" href="https://yurkingw.github.io/">Home</a>
        <span class="brand-gap" aria-hidden="true">·</span>
        <a class="brand" href="{{ "/" | url }}">{{ site.title }}</a>
      </div>
      <div class="seg theme-switch" role="group" aria-label="Color theme">
        <button type="button" data-theme-set="system" aria-pressed="true">Auto</button>
        <span class="seg-gap" aria-hidden="true">·</span>
        <button type="button" data-theme-set="day" aria-pressed="false">Day</button>
        <span class="seg-gap" aria-hidden="true">·</span>
        <button type="button" data-theme-set="night" aria-pressed="false">Night</button>
      </div>
    </div>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="notice" id="notice">
    <p>{{ site.footerNotice }}</p>
  </footer>
  <button type="button" class="back-to-top" aria-label="回顶" hidden aria-hidden="true">回顶</button>
  <script>
    (function () {
      var root = document.documentElement;
      var storageKey = "ygh-theme";
      var legacyKey = "xgr-theme";
      var buttons = document.querySelectorAll(".theme-switch button[data-theme-set]");
      function read() {
        try {
          var mode = localStorage.getItem(storageKey);
          if (mode === "day" || mode === "night" || mode === "system") return mode;
          var legacy = localStorage.getItem(legacyKey);
          if (legacy === "day" || legacy === "night" || legacy === "system") {
            localStorage.setItem(storageKey, legacy);
            return legacy;
          }
        } catch (e) {}
        return "system";
      }
      function apply(mode, persist) {
        if (mode === "day" || mode === "night") root.setAttribute("data-theme", mode);
        else root.removeAttribute("data-theme");
        buttons.forEach(function (button) {
          button.setAttribute("aria-pressed", button.getAttribute("data-theme-set") === mode ? "true" : "false");
        });
        if (persist) {
          try { localStorage.setItem(storageKey, mode); } catch (e) {}
        }
      }
      apply(read(), false);
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          apply(button.getAttribute("data-theme-set"), true);
        });
      });
    })();
  </script>
  <script>
    (function () {
      var button = document.querySelector(".back-to-top");
      if (!button) return;

      function prefersReducedMotion() {
        return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      }

      function sync() {
        var visible = window.scrollY >= window.innerHeight;
        if (visible) {
          var reveal = button.hidden || !button.classList.contains("is-visible");
          button.hidden = false;
          button.setAttribute("aria-hidden", "false");
          if (reveal && !prefersReducedMotion()) void button.offsetWidth;
          button.classList.add("is-visible");
          return;
        }
        button.classList.remove("is-visible");
        button.setAttribute("aria-hidden", "true");
        if (prefersReducedMotion()) button.hidden = true;
      }

      button.addEventListener("transitionend", function (event) {
        if (event.propertyName !== "opacity") return;
        if (!button.classList.contains("is-visible")) button.hidden = true;
      });

      button.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? "auto" : "smooth" });
      });

      var frame = 0;
      window.addEventListener("scroll", function () {
        if (frame) return;
        frame = window.requestAnimationFrame(function () {
          frame = 0;
          sync();
        });
      }, { passive: true });
      window.addEventListener("resize", sync);
      sync();
    })();
  </script>
</body>
</html>
